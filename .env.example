# Copy to .env and fill in the keys you want to auto-connect

OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional
J2P_LOG_LEVEL=INFO
J2P_AUTO_EXECUTE=1
J2P_EXECUTION_TIMEOUT=60
J2P_QUALITY_THRESHOLD=72
J2P_MAX_REPAIR_LOOPS=2

# LangSmith observability (optional)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGSMITH_API_KEY=
# LANGCHAIN_PROJECT=jupyter2pdf
